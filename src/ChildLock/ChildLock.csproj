<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ChildLock</AssemblyName>
    <RootNamespace>ChildLock</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\childlock.ico')">Assets\childlock.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Release builds ask Windows for admin rights at start, so they can also block input aimed at admin windows
    (Task Manager etc.); declining keeps ChildLock running without them. Debug builds never ask, so development
    and the integration test need no UAC prompt. Override either way with -p:ChildLockElevate=true|false.
    The manifest is always asInvoker: a requireAdministrator manifest would make declining the prompt fatal.
  -->
  <PropertyGroup>
    <ChildLockElevate Condition="'$(ChildLockElevate)' == '' and '$(Configuration)' == 'Release'">true</ChildLockElevate>
    <ChildLockElevate Condition="'$(ChildLockElevate)' == ''">false</ChildLockElevate>
    <DefineConstants Condition="'$(ChildLockElevate)' == 'true'">$(DefineConstants);CHILDLOCK_SELF_ELEVATE</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Release build: one small exe that uses the installed .NET 10 Desktop Runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Ship only the exe: no .pdb or .xml docs from referenced projects next to it. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChildLock.Core\ChildLock.Core.csproj" />
    <!-- Tray icon, native menus and toasts. A git submodule (clone this repo recursively). -->
    <ProjectReference Include="..\..\external\puretech-tray-dotnet\src\PureTech.Tray\PureTech.Tray.csproj" />
  </ItemGroup>

</Project>
